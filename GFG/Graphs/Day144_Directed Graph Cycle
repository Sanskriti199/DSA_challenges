class Solution {
  public:
    bool isCyclic(int V, vector<vector<int>> &edges) {
        // code here
        vector<int>adj[V];
        vector<int>inDegree(V,0);
        
        for(auto& edge:edges){
            int u=edge[0];
            int v=edge[1];
            adj[u].push_back(v);
            inDegree[v]++;
        }
        queue<int>q;
        for(int i=0;i<V;i++){
            if(inDegree[i]==0){
                q.push(i);
            }
        }
        int count=0;
        while(!q.empty()){
            int curr=q.front();
            q.pop();
            count++;
            
            
            for(int neighbor:adj[curr]){
                inDegree[neighbor]--;
                
                if(inDegree[neighbor]==0){
                    q.push(neighbor);
                }
            }
            
        }
        return(count!=V);
    }
};
