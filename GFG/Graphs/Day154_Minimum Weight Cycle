class Solution {
public:
    int findMinCycle(int V, vector<vector<int>>& edges) {
        vector<vector<pair<int, int>>> adj(V);
        for (auto& e : edges) {
            adj[e[0]].push_back({e[1], e[2]});
            adj[e[1]].push_back({e[0], e[2]});
        }

        int minCycle = 1e9;

        for (auto& e : edges) {
            int u = e[0], v = e[1], w = e[2];
            int d = dijkstra(V, adj, u, v, w, minCycle);
            if (d != 1e9) {
                minCycle = min(minCycle, d + w);
            }
        }

        return (minCycle == 1e9) ? -1 : minCycle;
    }

private:
    int dijkstra(int V, vector<vector<pair<int, int>>>& adj, int start, int target, int skipW, int limit) {
        vector<int> dist(V, 1e9);
        priority_queue<pair<int, int>, vector<pair<int, int>>, greater<pair<int, int>>> pq;

        dist[start] = 0;
        pq.push({0, start});

        bool skipped = false;

        while (!pq.empty()) {
            int d = pq.top().first;
            int curr = pq.top().second;
            pq.pop();

            if (d >= limit) continue; 
            if (d > dist[curr]) continue;
            if (curr == target) return d;

            for (auto& edge : adj[curr]) {
                int next = edge.first;
                int weight = edge.second;

                if (!skipped && ((curr == start && next == target) || (curr == target && next == start)) && weight == skipW) {
                    skipped = true;
                    continue;
                }

                if (dist[curr] + weight < dist[next]) {
                    dist[next] = dist[curr] + weight;
                    pq.push({dist[next], next});
                }
            }
        }
        return 1e9;
    }
};
