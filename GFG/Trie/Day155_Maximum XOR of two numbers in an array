class Solution {
    private:
    struct TrieNode{
        TrieNode* children[2];
        TrieNode(){
            children[0]=nullptr;
            children[1]=nullptr;
        }
    };
    void insert (TrieNode* root, int num){
        TrieNode* curr=root;
        for(int i=31;i>=0;i--){
            int bit=(num>>i)&1;
            if(!curr->children[bit]){
                curr->children[bit]=new TrieNode();
            }
            curr=curr->children[bit];
        }
    }
    int getMaxXORPair(TrieNode* root, int num){
        TrieNode* curr=root;
        int maxXorVal=0;
        for(int i=31;i>=0;i--){
            int bit=(num>>i)&1;
            int oppositeBit=1-bit;
            
            if(curr->children[oppositeBit]){
                maxXorVal|=(1<<i);
                curr=curr->children[oppositeBit];
            }
            else{
                curr=curr->children[bit];
            }
        }
        return maxXorVal;
    }
  public:
    int maxXor(vector<int> &arr) {
        // code here
        TrieNode* root=new TrieNode();
        insert(root,arr[0]);
        int maxResult=0;
        
        for(int i=1;i<arr.size();i++){
            maxResult=max(maxResult, getMaxXORPair(root, arr[i]));
            insert(root, arr[i]);
        }
        return maxResult;
    }
};
