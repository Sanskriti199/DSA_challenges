// User function template for C++
class Trie {
    private:
    struct TrieNode{
        TrieNode*  children[26];
        bool isEndOfWord;
        
        TrieNode(){
            isEndOfWord=false;
            for(int i=0;i<26;i++){
                children[i]=nullptr;
            }
        }
    };
    TrieNode* root;
  public:

    Trie() {
        // implement Trie
        root = new TrieNode();
    }

    void insert(string &word) {
        // insert word into Trie
        TrieNode* curr=root;
        for(char ch:word){
            int index=ch-'a';
            if(curr->children[index]==nullptr){
                curr->children[index]=new TrieNode();
            }
            curr=curr->children[index];
        }
        curr->isEndOfWord=true;
    }

    bool search(string &word) {
        // search word in the Trie
        TrieNode* curr=root;
        for(char ch:word){
            int index=ch-'a';
            if(curr->children[index]==nullptr){
                return false;
            }
            curr=curr->children[index];
        }
        return curr->isEndOfWord;
    }

    bool isPrefix(string &word) {
        // search prefix word in the Trie
        TrieNode* curr=root;
        for(char ch:word){
            int index=ch-'a';
            if(curr->children[index]==nullptr){
                return false;
            }
            curr=curr->children[index];
        }
        return true;
    }
};
